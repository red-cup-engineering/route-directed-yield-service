    "distributor": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "wellToken": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "poolAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "cycleId": { "type": "string", "minLength": 1 },
    "chainId": { "type": "string" },
    "mandate": { "type": "object" }
